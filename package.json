{
  "name": "revolution-game",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "npx kill-port 3001 5173",
    "dev": "concurrently --names \"server,client\" --prefix-colors \"blue,green\" \"pnpm --filter revolution-server dev\" \"pnpm --filter revolution-client dev\"",
    "kill": "npx kill-port 3001 5173",
    "dev:server": "pnpm --filter revolution-server dev",
    "dev:client": "pnpm --filter revolution-client dev",
    "build": "pnpm --filter revolution-server build && pnpm --filter revolution-client build",
    "dev:clear-limits": "docker exec revolution_redis redis-cli EVAL \"local keys = redis.call('keys', 'rl:*') for _, k in ipairs(keys) do redis.call('del', k) end return #keys\" 0",
    "lint": "eslint \"client/src/**/*.{ts,tsx}\" \"server/src/**/*.ts\"",
    "format": "prettier --write \"client/src/**/*.{ts,tsx}\" \"server/src/**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.57.0",
    "concurrently": "^8.2.2",
    "eslint": "^10.0.3",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.57.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}