# .env.example
#
# This file is a TEMPLATE — it shows what environment variables are needed
# but does NOT contain real secrets. Commit this to git.
#
# To use it:
#   1. Copy this file: cp .env.example .env
#   2. Fill in the real values in .env
#   3. .env is in .gitignore so your secrets never get pushed to GitHub
#
# Why environment variables instead of hardcoding values?
#   - Security: secrets stay out of your code and git history
#   - Flexibility: dev/staging/prod can have different values without code changes

# ── Database ─────────────────────────────────────────────────────────────────
# This is the connection string Prisma uses to connect to PostgreSQL.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# These values must match what's in docker-compose.yml
DATABASE_URL="postgresql://revolution_user:revolution_pass@localhost:5433/revolution_db"

# ── Redis ─────────────────────────────────────────────────────────────────────
# Connection string for Redis.
# Using port 6380 because 6379 may be taken by a native Windows Redis installation.
# (Same situation as Postgres using 5433 instead of 5432.)
# This must match the host port in docker-compose.yml.
REDIS_URL="redis://localhost:6380"

# ── Auth ──────────────────────────────────────────────────────────────────────
# The secret key used to sign JWT tokens.
# IMPORTANT: Make this long and random in production (32+ characters).
# Anyone with this secret can forge tokens and log in as any user.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-this-with-a-long-random-string-in-production"

# How long a JWT token stays valid before the user must log in again.
# "7d" = 7 days. "1h" = 1 hour.
JWT_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# The URL(s) of your frontend. Used by CORS to allow browser requests.
# Single machine (default):
CLIENT_URL="http://localhost:5173"
# Cross-machine testing (comma-separated, no spaces):
# CLIENT_URL="http://localhost:5173,http://192.168.1.50:5173"

# "development" or "production"
NODE_ENV="development"
