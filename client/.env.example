# Client environment variables
# Copy this file to .env and fill in your values.
# VITE_ prefix is required — Vite only exposes variables with this prefix to the browser.

# ── Server URL ─────────────────────────────────────────────────────────────────
# Leave unset for single-machine localhost development.
# Set to your machine's LAN IP for cross-machine testing.
#
# Single machine (default, no change needed):
#   VITE_SERVER_URL=http://localhost:3001
#
# Cross-machine (replace with your machine's LAN IP):
#   VITE_SERVER_URL=http://192.168.1.50:3001
#
# Find your IP on Windows: run `ipconfig` and look for "IPv4 Address"
#
# VITE_SERVER_URL=http://localhost:3001
